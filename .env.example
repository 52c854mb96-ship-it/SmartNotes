# Passordet eieren logger inn i appen med (brukernavnet kan stå tomt). Velg et langt, unikt passord.
APP_PASSWORD=

# Claude API-nøkkel fra https://console.anthropic.com (lagres bare på serveren).
ANTHROPIC_API_KEY=

# Valgfritt
# CLAUDE_MODEL=claude-sonnet-5-5   # konvertering og retting; claude-opus-5-5 er grundigere, men koster det dobbelte
# CLAUDE_MODEL_FLASHCARDS=claude-haiku-5-5   # kortstokker
# CLAUDE_MODEL_TOC=claude-haiku-5-5   # innholdsfortegnelser og kompetansemål
# CLAUDE_EFFORT=medium        # low | medium | high | xhigh | max (grundighet ved konvertering)
# CLAUDE_FALLBACKS=true       # reservemodell hvis Claude feilaktig avslår et notat
# SEED_TEXTBOOKS=fysikk-1-lk20,kjemi-1-lk20,biologi-1-lk20  # fagoppsett som legges inn én gang hver (none = tomt fag)
# MAX_PAGES_PER_NOTE=30
# COOKIE_SECURE=true          # sett til false KUN hvis du kjører uten HTTPS på et lukket nett
# SMARTNOTES_FAKE_CLAUDE=0    # 1 = testinnhold i stedet for Claude (utvikling)
# FREE_CONVERT_MODEL=claude-haiku-5-5   # konvertering for gratisbrukerne (eieren bruker CLAUDE_MODEL)
# MIN_AGE=15                  # laveste alder ved registrering
# INVITE_DAYS=14              # hvor lenge en invitasjonskode gjelder
# RESET_LINK_HOURS=48         # hvor lenge en lenke for nytt passord gjelder
# TRUST_PROXY_HOPS=1          # proxyer foran serveren; 0 når den nås direkte
# FREE_PAGES_PER_DAY=15       # sider per døgn for en gratiskonto
# FREE_DECKS_PER_DAY=2        # kortstokker per døgn for en gratiskonto
# FREE_TOC_PER_DAY=3          # innholdsfortegnelser med AI per døgn for en gratiskonto
# FREE_QUEUE_MAX=20           # notater i kø samtidig for en gratiskonto
# FREE_DAILY_BUDGET_NOK=30    # AI-budsjett per døgn for alle gratiskontoene samlet (0 = uten grense)
